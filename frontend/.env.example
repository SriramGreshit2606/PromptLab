# Leave empty in development: requests go to /api and Vite proxies them to the backend (no CORS needed).
# Set to the backend origin (e.g. https://api.example.com) for a deployed build.
# A direct cross-origin URL requires CORSMiddleware to be added to the FastAPI backend.
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api requests.
VITE_PROXY_TARGET=http://localhost:8000
